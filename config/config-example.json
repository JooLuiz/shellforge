{
  "browserAutomation": {
    "log-email": {
      "url": "https://example.com/login",
      "usernameInput": "#email",
      "usernameValue": "user@example.com",
      "passwordInput": "#password",
      "passwordValue": "your-password",
      "loginButton": "#submit"
    },
    "multi-step-login": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://example.com/login"
        },
        {
          "action": "type",
          "selector": "#username-input-field",
          "value": "your-username"
        },
        {
          "action": "click",
          "selector": "#nextBtn",
          "waitForSelector": "#password-input-group:not(.hidden) #password-input-field"
        },
        {
          "action": "type",
          "selector": "#password-input-field",
          "value": "your-password"
        },
        {
          "action": "click",
          "selector": "#loginbtn"
        }
      ]
    },
    "lancar-horas-clockify": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://app.clockify.me/login"
        },
        {
          "action": "setWebStorage",
          "localStorage": {
            "token": "your-clockify-token",
            "userId": "your-user-id"
          }
        },
        {
          "action": "navigate",
          "url": "https://app.clockify.me/calendar"
        },
        {
          "action": "wait",
          "selector": "weekly-view",
          "timeout": 10000
        },
        {
          "action": "forEachElement",
          "selector": ".cl-calendar-entry.cl-calendar-entry-integration.cl-p-0",
          "textContentSelector": ".cl-h-100.z-index-on-top",
          "excludeTextPatterns": ["OOO", "Almoço"],
          "clickSelector": ".cl-calendar-integrations-icons",
          "skipIfPositionMatch": {
            "scopeSelector": ".drop-zone",
            "matchSelector": ".cl-calendar-entry:not(.cl-calendar-entry-integration)"
          },
          "steps": [
            {
              "action": "wait",
              "selector": "ngb-modal-window",
              "timeout": 5000
            },
            {
              "action": "click",
              "selector": "button[data-cy='project']"
            },
            {
              "action": "wait",
              "selector": "project-picker"
            },
            {
              "action": "click",
              "selector": "button.cl-btn-project-picker[title='Office Depot - VTEX Migration']"
            },
            {
              "action": "wait",
              "ms": 500
            },
            {
              "action": "click",
              "selector": "button.cl-btn-primary",
              "jsClick": true
            },
            {
              "action": "wait",
              "ms": 1000
            }
          ]
        }
      ]
    }
  },
  "scheduler": {
    "serverPort": 3002,
    "userPassword": ""
  }
}
